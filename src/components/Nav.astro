---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
// Ordered by what Aisha asks before she'd install anything: what her
// clinician gets, what it asks of her, whether it punishes a bad week, where
// her data goes, and what it costs. For clinicians lives in the footer; it's
// a page she forwards, not one she reads.
const links = [
  { href: "/report", label: "Sample report" },
  { href: "/what-it-tracks", label: "What it tracks" },
  { href: "/first-six-weeks", label: "The first six weeks" },
  { href: "/your-data", label: "Your data" },
  { href: "/#get", label: "Price" },
];
---
<header>
  <div class="shell">
    <nav class="nav" aria-label="Primary">
      <a class="brand" href="/">
        <img src="/brand/symetric-logo.svg" alt="" width="28" height="28" />
        symetric
      </a>
      <a class="btn btn-primary nav-cta" href="/#demo">Try it</a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" />
      <label for="nav-toggle" class="nav-burger" aria-label="Menu">
        <span></span>
      </label>
      <div class="navlinks">
        {links.map((l) => (
          <a href={l.href} aria-current={currentPath === l.href ? "page" : undefined}>{l.label}</a>
        ))}
      </div>
    </nav>
  </div>
  <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch to light mode">
    <svg class="icon-sun" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="10" cy="10" r="4" />
      <path stroke-linecap="round" d="M10 1.5v2M10 16.5v2M18.5 10h-2M3.5 10h-2M15.6 4.4l-1.4 1.4M5.8 14.2l-1.4 1.4M15.6 15.6l-1.4-1.4M5.8 5.8L4.4 4.4" />
    </svg>
    <svg class="icon-moon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 12.4A7 7 0 0 1 7.6 3a7 7 0 1 0 9.4 9.4Z" />
    </svg>
  </button>
</header>

<style>
  /* Desktop order: brand, links, CTA. The links sit in the middle column. */
  @media (min-width: 901px) {
    .navlinks { grid-column: 2; grid-row: 1; }
    .nav-cta { grid-column: 3; grid-row: 1; }
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");

  function current() {
    return document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
  }

  function syncLabel() {
    const isLight = current() === "light";
    btn?.setAttribute("aria-label", isLight ? "Switch to dark mode" : "Switch to light mode");
  }

  syncLabel();

  btn?.addEventListener("click", () => {
    const next = current() === "light" ? "dark" : "light";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("symetric-theme", next);
    syncLabel();
  });
</script>
