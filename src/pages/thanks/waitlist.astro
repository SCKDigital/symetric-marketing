---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="symetric: You're on the waitlist"
  description="Thanks for joining the symetric waitlist."
>
  <div class="shell acc-motivation">
    <section class="page-head" style="padding-bottom:96px">
      <p class="eyebrow">Waitlist</p>
      <h1>You&rsquo;re on the list.</h1>
      <p class="lede">We&rsquo;ll email you once, when symetric is available where you are. Nothing else.</p>
      <div class="cta-row" style="margin-top:28px">
        <a class="btn btn-primary" href="/">Back to the homepage</a>
        <a class="btn btn-ghost" href="/what-it-tracks">See what symetric tracks</a>
      </div>
    </section>
  </div>
</BaseLayout>
