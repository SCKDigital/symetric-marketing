---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="symetric: Message sent"
  description="Thanks for getting in touch with symetric."
>
  <div class="shell acc-sensory">
    <section class="page-head" style="padding-bottom:96px">
      <p class="eyebrow">Message sent</p>
      <h1>Thanks, we&rsquo;ve got it.</h1>
      <p class="lede">A real person reads every message. We&rsquo;ll reply to the email address you gave us.</p>
      <div class="cta-row" style="margin-top:28px">
        <a class="btn btn-primary" href="/">Back to the homepage</a>
      </div>
    </section>
  </div>
</BaseLayout>
