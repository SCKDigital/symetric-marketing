---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { inline } from "../lib/inline";

// The words are in src/content/tracks/what-it-tracks.md (edited in Tina).
// The body domain list there follows the app's evening check-in order
// (symetric-native src/lib/body/constants.ts, CHECKIN_BODY_DOMAIN_ORDER).
const entry = await getEntry("tracks", "what-it-tracks");
if (!entry) throw new Error("src/content/tracks/what-it-tracks.md is missing");
const c = entry.data;

// Each mind domain shown in its own colour, the only place on the site where
// a colour sits next to the name it stands for. These are the app's names,
// not copy, so they stay in code.
const mindDomains = [
  { name: "Mood", c: "var(--mood)" },
  { name: "Energy", c: "var(--energy)" },
  { name: "Anxiety", c: "var(--anxiety)" },
  { name: "Concentration", c: "var(--concentration)" },
  { name: "Irritability", c: "var(--irritability)" },
  { name: "Social depletion", c: "var(--social)" },
  { name: "Sensory overwhelm", c: "var(--sensory)" },
  { name: "Motivation", c: "var(--motivation)" },
];
---

<BaseLayout title={c.seoTitle} description={c.seoDescription}>
  <div class="shell">
    <section class="page-head acc-energy" style="max-width:none">
      <div class="grid-2" style="gap:48px;align-items:center">
        <div>
          <p class="eyebrow">{c.eyebrow}</p>
          <h1>{c.heading}</h1>
          <p class="lede" set:html={inline(c.lede)} />
        </div>
        <div class="card" style="padding:6px 24px" aria-label="What symetric can track, and whether each is always on or optional">
          {c.tiers.map((t) => (
            <div class="tier">
              <b>{t.name}</b>
              <span class={`badge ${t.on ? "badge-on" : ""}`}>{t.status}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ MIND + SLEEP ============ -->
    <section class="sec acc-concentration" aria-labelledby="core-h">
      <p class="eyebrow">{c.core.eyebrow}</p>
      <h2 id="core-h">{c.core.heading}</h2>
      <div class="grid-2" style="margin-top:32px">
        <div class="card acc-mood">
          <i class="mark"></i>
          <h3>{c.core.mindTitle}</h3>
          <p set:html={inline(c.core.mindText)} />
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:16px">
            {mindDomains.map((d) => (
              <span class="chip" style="display:inline-flex;align-items:center;gap:7px"><i style={`width:8px;height:8px;border-radius:4px;background:${d.c}`}></i>{d.name}</span>
            ))}
          </div>
        </div>
        <div class="card acc-sleep">
          <i class="mark"></i>
          <h3>{c.core.sleepTitle}</h3>
          <p set:html={inline(c.core.sleepText)} />
        </div>
      </div>
      <p class="muted" style="font-size:20px;line-height:1.5;max-width:34em;margin-top:40px" set:html={inline(c.core.quiet)} />
    </section>

    <!-- ============ BODY ============ -->
    <section class="panel acc-anxiety" aria-labelledby="body-h" style="margin-top:96px">
      <p class="eyebrow">{c.body.eyebrow}</p>
      <h2 id="body-h">{c.body.heading}</h2>
      <p class="muted" style="margin-top:16px;max-width:40em" set:html={inline(c.body.intro)} />
      <div class="plain" style="margin-top:28px">
        <div class="line">
          <span class="tick" aria-hidden="true">✓</span>
          <span class="txt"><b>{c.body.domains.length} domains you can check in on:</b> {c.body.domains.join(", ")}. <Fragment set:html={inline(c.body.domainsNote)} /></span>
        </div>
        <div class="line">
          <span class="tick" aria-hidden="true">✓</span>
          <span class="txt"><b>{c.body.events.length} events you can log as they happen:</b> {c.body.events.join(", ")}.</span>
        </div>
        <div class="line">
          <span class="tick" aria-hidden="true">✓</span>
          <span class="txt"><b>{c.body.mapTitle}</b> <Fragment set:html={inline(c.body.mapText)} /></span>
        </div>
      </div>
      <p class="fine" style="margin-top:20px" set:html={inline(c.body.note)} />
    </section>

    <!-- ============ CYCLE ============ -->
    <section class="sec acc-irritability" aria-labelledby="cycle-h">
      <p class="eyebrow">{c.cycle.eyebrow}</p>
      <h2 id="cycle-h">{c.cycle.heading}</h2>
      <p class="muted" style="margin-top:16px;max-width:40em" set:html={inline(c.cycle.text)} />
      <div class="cycle-callout" style="margin-top:24px;max-width:46em">
        {c.cycle.callout.map((p) => <p set:html={inline(p)} />)}
      </div>
    </section>

    <!-- ============ CLOSE ============ -->
    <section class="closing acc-motivation" aria-labelledby="close-h">
      <h2 id="close-h">{c.closing.heading}</h2>
      <div class="cta-row">
        <a class="btn btn-primary" href="/#demo">{c.closing.tryLabel}</a>
        <a class="btn btn-ghost" href="/report">{c.closing.reportLabel}</a>
      </div>
    </section>
  </div>
</BaseLayout>
