---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="symetric: Page not found"
  description="This page doesn't exist. Here's how to find your way back."
>
  <div class="shell">
    <section class="sec">
      <p class="sec-label">404</p>
      <h1 style="max-width:none">This page isn&rsquo;t here.</h1>
      <p class="lede" style="max-width:52ch">Might have moved, might never have existed. Either way, nothing&rsquo;s wrong on your end.</p>
      <div class="cta-row" style="margin-top:28px">
        <a class="btn btn-primary" href="/">Back to the homepage</a>
        <a class="btn btn-ghost" href="/what-it-tracks">See what symetric tracks</a>
      </div>
    </section>
  </div>
</BaseLayout>
