---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { inline } from "../lib/inline";

// The words are in src/content/home/home.md (edited in Tina). Layout, icons
// and section colours stay here, so an edit can't break the design.
//
// The three findings around the demo are real: each is in the sample report
// (public/symetric-sample-report.pdf, built by symetric-native's
// scripts/sample-report from Aisha's data). If the report is rebuilt and a
// figure moves, change it in home.md too.
const entry = await getEntry("home", "home");
if (!entry) throw new Error("src/content/home/home.md is missing");
const c = entry.data;

// Colours cycle through the mind domains so none leads, whatever the count.
const trustAcc = ["acc-anxiety", "acc-concentration", "acc-irritability"];
const factAcc = ["acc-mood", "acc-sensory", "acc-social", "acc-motivation"];
const getsAcc = ["acc-energy", "acc-concentration", "acc-motivation"];
const pick = (list: string[], i: number) => list[i % list.length];

// The demo is symetric-native built for web (its docs/web-demo.md), deployed
// as its own Vercel project. Change this if it moves to a custom domain.
const DEMO_URL = "https://symetric-demo.vercel.app";

const icon = (d: string) =>
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const factIcons = [
  icon('<rect x="6" y="2" width="12" height="20" rx="3"></rect><path d="M11 18h2"></path>'),
  icon('<circle cx="12" cy="12" r="9"></circle><path d="M5.6 5.6l12.8 12.8"></path>'),
  icon('<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path>'),
  icon('<path d="M4 12a8 8 0 1 0 2.3-5.7L4 4v5h5"></path>'),
];
const dataIcons = [
  icon('<rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path>'),
  icon('<circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path>'),
  icon('<path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M5 21h14"></path>'),
];
---

<BaseLayout title={c.seoTitle} description={c.seoDescription} structuredData>
  <div class="shell">

    <!-- ============ HERO, demo first ============ -->
    <section class="hero acc-energy" aria-labelledby="hero-h">
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 id="hero-h">{c.hero.heading}</h1>
      <p class="lede" set:html={inline(c.hero.lede)} />
      <div class="cta-row">
        <a class="btn btn-primary" href="#demo">{c.hero.tryLabel}</a>
        <a class="btn btn-ghost" href="#report">{c.hero.reportLabel}</a>
      </div>
      <div class="trust">
        {c.hero.trust.map((t, i) => <span class={pick(trustAcc, i)}><i class="dot"></i>{t}</span>)}
      </div>

      <div class="stage" id="demo">
        {c.insights.slice(0, 3).map((f, i) => (
          <div class={`float float-${i + 1} acc-${f.colour}`}>
            <small>{f.label}</small>
            <p set:html={inline(f.text)} />
          </div>
        ))}
        <div class="phone">
          <img src="/demo-poster.webp" alt="The Symetric Today screen: sleep logged, the next mind check-in at 2:40 pm, and the body check-in opening at 6 pm." width="600" height="1365" />
          <div class="phone-cta">
            <!-- On a wide screen the script below swaps the poster for the app
                 in this phone. On a narrow one, or without JS, the link opens
                 the full-screen demo page instead. -->
            <a class="btn" href={`${DEMO_URL}/demo?start`} data-demo-start>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
              {c.demo.buttonLabel}
            </a>
            <p>{c.demo.note}</p>
          </div>
        </div>
      </div>
      <div class="steps" aria-label="What the guided tour covers">
        {c.demo.steps.map((s, i) => <span class="step"><b>{i + 1}</b>{s}</span>)}
      </div>
    </section>

    <!-- ============ FACTS ============ -->
    <section class="facts grid-4" aria-label="At a glance">
      {c.facts.map((f, i) => (
        <div class={`fact ${pick(factAcc, i)}`}>
          <Fragment set:html={pick(factIcons, i)} />
          <p><b>{f.title}</b>{f.text}</p>
        </div>
      ))}
    </section>

    <!-- ============ WHAT YOU GET ============ -->
    <section class="sec acc-irritability" id="how" aria-labelledby="gets-h">
      <p class="eyebrow">{c.gets.eyebrow}</p>
      <h2 id="gets-h" style="max-width:18em">{c.gets.heading}</h2>
      <div class="grid-3 swipe" style="margin-top:32px">
        {c.gets.cards.map((g, i) => (
          <div class={`card ${pick(getsAcc, i)}`}><i class="mark"></i><h3>{g.title}</h3><p set:html={inline(g.text)} /></div>
        ))}
      </div>
    </section>

    <!-- ============ SAMPLE REPORT ============ -->
    <section class="panel acc-anxiety" id="report" aria-labelledby="report-h" style="margin-top:96px">
      <div class="split">
        <div>
          <p class="eyebrow">{c.report.eyebrow}</p>
          <h2 id="report-h">{c.report.heading}</h2>
          <p class="muted" style="margin-top:16px;font-size:18px" set:html={inline(c.report.text)} />
          <div class="chips">{c.report.chips.map((ch) => <span class="chip">{ch}</span>)}</div>
          <div class="cta-row">
            <a class="btn btn-primary" href="/symetric-sample-report.pdf">{c.report.buttonLabel}</a>
          </div>
          <p class="fine" style="margin-top:14px" set:html={inline(c.report.fine)} />
        </div>
        <div class="fan" aria-hidden="true">
          <img src="/report/page-01.webp" alt="" width="960" height="742" loading="lazy" />
          <img src="/report/page-04.webp" alt="" width="960" height="742" loading="lazy" />
          <img src="/report/page-10.webp" alt="" width="960" height="742" loading="lazy" />
        </div>
      </div>
    </section>

  </div>

  <!-- ============ WHO IT'S FOR, and the first six weeks ============ -->
  <section class="band acc-social" style="text-align:center" aria-labelledby="who-h">
    <div class="shell">
      <p class="eyebrow">{c.who.eyebrow}</p>
      <h2 id="who-h" style="max-width:16em;margin-left:auto;margin-right:auto">{c.who.heading}</h2>
      <p class="muted" style="font-size:20px;line-height:1.5;max-width:34em;margin:20px auto 0" set:html={inline(c.who.text)} />
      <div class="grid-4 swipe" style="margin-top:48px;text-align:left" id="weeks">
        {c.who.weeks.map((w) => (
          <div class="card week">
            <small>{w.when}</small>
            <b>{w.lead}</b>
            <p>{w.rest}</p>
            <div class="meter" aria-hidden="true">
              {Array.from({ length: 6 }).map((_, i) => <i class={i < w.filled ? "on" : ""}></i>)}
            </div>
          </div>
        ))}
      </div>
      <p style="margin-top:28px"><a href="/first-six-weeks">{c.who.linkText}</a></p>
    </div>
  </section>

  <div class="shell">

    <!-- ============ YOUR DATA ============ -->
    <section class="panel acc-sensory" id="data" aria-labelledby="data-h" style="margin-top:96px">
      <p class="eyebrow">{c.data.eyebrow}</p>
      <h2 id="data-h" style="max-width:18em">{c.data.heading}</h2>
      <div class="grid-3 swipe" style="margin-top:32px">
        {c.data.cards.map((d, i) => (
          <div class="card"><span class="iconwrap" set:html={pick(dataIcons, i)} /><h3 style="font-size:18px">{d.title}</h3><p set:html={inline(d.text)} /></div>
        ))}
      </div>
      <p style="margin-top:22px;font-weight:600"><a href="/your-data">{c.data.linkText}</a></p>
    </section>

    <!-- ============ PRICE ============ -->
    <section class="sec acc-mood" id="get" aria-labelledby="price-h">
      <div class="grid-2" style="gap:56px;align-items:center">
        <div>
          <p class="eyebrow">{c.price.eyebrow}</p>
          <h2 id="price-h">{c.price.heading}</h2>
          <p class="muted" style="margin-top:14px;font-size:18px" set:html={inline(c.price.text)} />
        </div>
        <div class="card price" style="padding:40px;border-radius:28px">
          <p class="amt">{c.price.amount}</p>
          <p class="muted" style="margin-top:6px">{c.price.terms}</p>
          <ul>
            {c.price.included.map((item) => (
              <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>{item}</li>
            ))}
          </ul>
          <!-- TODO: real App Store and Google Play listing URLs not available yet -->
          <div class="store">
            <a class="storebtn" href="#"><small>Download on the</small><span>App Store</span></a>
            <a class="storebtn" href="#"><small>Get it on</small><span>Google Play</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="sec acc-concentration" id="faq" aria-labelledby="faq-h">
      <div class="faq">
        <p class="eyebrow" style="text-align:center">{c.faq.eyebrow}</p>
        <h2 id="faq-h" style="text-align:center">{c.faq.heading}</h2>
        <div style="margin-top:28px">
          {c.faq.items.map((f) => (
            <details><summary>{f.q}</summary><p set:html={inline(f.a)} /></details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ WHO BUILT IT ============ -->
    <section class="sec acc-anxiety" aria-labelledby="founder-h">
      <div class="card" style="padding:44px;border-radius:28px;max-width:860px">
        <p class="eyebrow">{c.founder.eyebrow}</p>
        <h2 id="founder-h">{c.founder.heading}</h2>
        <p class="muted" style="margin-top:16px;font-size:18px" set:html={inline(c.founder.text)} />
        <p style="margin-top:18px;font-weight:600"><a href="/about">{c.founder.linkText}</a></p>
      </div>
    </section>

    <!-- ============ CLOSE AND WAITLIST ============ -->
    <section class="closing acc-motivation" aria-labelledby="close-h">
      <h2 id="close-h">{c.closing.heading}</h2>
      <div class="cta-row">
        <a class="btn btn-primary" href="#get">{c.closing.getLabel}</a>
        <a class="btn btn-ghost" href="#demo">{c.closing.demoLabel}</a>
      </div>
      <p class="eyebrow" style="margin-top:56px">{c.closing.waitlistLabel}</p>
      <!-- Posts to the app backend's site-forms function (symetric-native repo, supabase/functions/site-forms),
           which stores the address and redirects to /thanks/waitlist. -->
      <form class="waitlist-form" method="post" action="https://ovfnewvetuimfqitswdk.supabase.co/functions/v1/site-forms">
        <input type="hidden" name="form" value="waitlist" />
        <div class="hp" aria-hidden="true"><label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
        <label for="waitlist-email" class="sr-only">Email address</label>
        <input type="email" id="waitlist-email" name="email" placeholder="you@example.com" required />
        <button type="submit" class="btn btn-primary">{c.closing.waitlistButton}</button>
      </form>
    </section>

  </div>
</BaseLayout>

<script>
  // The app is laid out for a 390pt-wide phone. Rendered at that width and
  // scaled down to the frame, it looks like the poster it replaces; the frame
  // keeps the poster's size, so nothing on the page moves.
  const APP_WIDTH = 390;
  const start = document.querySelector<HTMLAnchorElement>("[data-demo-start]");
  const phone = start?.closest<HTMLElement>(".phone");
  const poster = phone?.querySelector("img");

  start?.addEventListener("click", (e) => {
    if (!phone || !poster || window.innerWidth < 600) return;
    e.preventDefault();
    const frame = document.createElement("iframe");
    frame.className = "phone-app";
    frame.title = "Symetric demo";
    frame.src = new URL("/", start.href).href;
    const fit = () => {
      const scale = poster.clientWidth / APP_WIDTH;
      frame.style.width = `${APP_WIDTH}px`;
      frame.style.height = `${poster.clientHeight / scale}px`;
      frame.style.transform = `scale(${scale})`;
    };
    fit();
    new ResizeObserver(fit).observe(poster);
    phone.append(frame);
    phone.classList.add("is-live");
    // The button sits mid-phone, so the tab bar can be below the fold.
    phone.scrollIntoView({ block: "center", behavior: "smooth" });
    frame.addEventListener("load", () => frame.focus(), { once: true });
  });
</script>
