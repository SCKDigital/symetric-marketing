---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="symetric: That didn't go through"
  description="Something went wrong sending the form."
>
  <div class="shell acc-sensory">
    <section class="page-head" style="padding-bottom:96px">
      <p class="eyebrow">Not sent</p>
      <h1>That didn&rsquo;t go through.</h1>
      <p class="lede">Check the email address and try again. If it keeps happening, email us directly at <a href="mailto:support@symetric.app">support@symetric.app</a>.</p>
      <div class="cta-row" style="margin-top:28px">
        <a class="btn btn-primary" href="/support">Contact form</a>
        <a class="btn btn-ghost" href="/#close-h">Waitlist</a>
      </div>
    </section>
  </div>
</BaseLayout>
